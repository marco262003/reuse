# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL
DB_ENGINE=postgres
DB_NAME=reuse
DB_USER=reuse_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Email (leave EMAIL_HOST empty to print emails in the terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=REUSE <no-reply@reuse.local>

# SMS (leave empty to skip SMS)
SMS_API_KEY=
SMS_SENDER_NAME=

# ID uploads and face login.
# Leave ID_BUCKET empty during development: REUSE then uses the local stand-in
# that runserver starts by itself.
ID_BUCKET=
# Empty for Amazon S3; the service's address for any other S3-compatible storage.
S3_ENDPOINT_URL=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Encrypts stored face templates. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_TEMPLATE_KEY=
